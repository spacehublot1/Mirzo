<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Miyalar" android:textColor="@color/accent"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Istalgancha AI kaliti qo\'shing. Bir provayderdan bir nechta kalit ham bo\'ladi — har biri alohida miya."
        android:textColor="@color/muted" android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/brainsList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/addBrainButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="+ Miya qo\'shish"
        android:textColor="@color/accent" android:backgroundTint="@color/panel" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Bosh miya (javoblarni birlashtiradi)"
        android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold" />
    <Spinner
        android:id="@+id/aggregatorSpinner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:background="@color/panel" android:padding="8dp" />

    <CheckBox
        android:id="@+id/voiceReply" style="@style/JRadio"
        android:layout_marginTop="12dp" android:text="Javobni ovoz bilan o\'qib bersin (TTS)" />

    <TextView
        android:id="@+id/rateLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Gapirish tezligi: 1.0x"
        android:textColor="@color/muted" android:textSize="13sp" />
    <SeekBar
        android:id="@+id/speechRate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:max="30" android:progress="10" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Saqlash"
        android:textColor="@color/bg" android:backgroundTint="@color/accent" />
</LinearLayout>
